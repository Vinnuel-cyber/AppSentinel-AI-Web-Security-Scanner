# ==============================================================================
# AppSentinel - Environment Configuration Template
# ==============================================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production

# Database Configuration (MySQL appsentinel_db)
DB_USER=root
DB_PASSWORD=your_secure_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=appsentinel_db

# Optional Direct Database URI (overrides individual DB_* parameters if specified)
# For MySQL: mysql+pymysql://root:password@127.0.0.1:3306/appsentinel_db
# For SQLite fallback during testing/offline: sqlite:///instance/appsentinel.db
DATABASE_URL=

# AI Security Analyst (V8)
# Cloud AI is optional; AppSentinel includes a deterministic offline fallback engine.
# Note: OpenAI API access and billing are separate from a ChatGPT Plus subscription.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=2000
AI_DAILY_LIMIT_PER_USER=50

# Scanner Controls
SCANNER_MAX_CONCURRENCY=5
SCANNER_REQUEST_TIMEOUT=10
SCANNER_ALLOW_PRIVATE_IPS=False
