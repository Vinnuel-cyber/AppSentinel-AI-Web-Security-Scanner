# ==============================================================================
# AppSentinel - Environment Configuration Template (.env.example)
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this template to create your local environment file:
#      cp .env.example .env         # Linux / macOS
#      Copy-Item .env.example .env  # Windows PowerShell
# 2. Populate all required secrets with secure, unique values before running.
# 3. NEVER commit your actual '.env' file or any secrets to source control.
#    The '.env' file is strictly excluded by .gitignore.
#
# Generate a strong, cryptographically secure SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask Application Configuration
# ------------------------------------------------------------------------------
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# REQUIRED in production mode and Docker Compose:
# Must be at least 16 characters (32+ hex characters strongly recommended).
# Do not use default or placeholder values in production.
SECRET_KEY=replace_with_a_cryptographically_secure_random_key_min_32_chars

# Network Binding (Docker Compose & Local Dev)
WEB_BIND_IP=127.0.0.1
WEB_PORT=5000

# ------------------------------------------------------------------------------
# Database Configuration (MySQL / Docker Compose)
# ------------------------------------------------------------------------------
# Dedicated application user
DB_USER=appsentinel_user

# REQUIRED: Strong application database password
DB_PASSWORD=replace_with_strong_database_password

# Database hostname (use '127.0.0.1' for local development, 'db' inside Docker Compose)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=appsentinel_db

# REQUIRED for Docker Compose MySQL container initialization
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password

# Host binding and port forwarding for Docker Compose MySQL container
DB_BIND_IP=127.0.0.1
DB_PORT_FORWARD=3307

# Optional Direct Database URI (overrides individual DB_* parameters if specified)
# For MySQL: mysql+pymysql://appsentinel_user:replace_with_strong_database_password@127.0.0.1:3306/appsentinel_db
# For SQLite (zero-setup local development/testing): sqlite:///instance/appsentinel.db
DATABASE_URL=

# ------------------------------------------------------------------------------
# AI Security Analyst (V8)
# ------------------------------------------------------------------------------
# Cloud AI is optional; AppSentinel includes a deterministic offline fallback engine.
# When AI_ENABLED=false or OPENAI_API_KEY is empty, AppSentinel operates 100% offline.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT=30
AI_MAX_OUTPUT_TOKENS=2000
AI_DAILY_LIMIT_PER_USER=50

# ------------------------------------------------------------------------------
# Security Scanner Settings
# ------------------------------------------------------------------------------
SCANNER_MAX_CONCURRENCY=5
SCANNER_REQUEST_TIMEOUT=10
SCANNER_ALLOW_PRIVATE_IPS=False

# ------------------------------------------------------------------------------
# PDF Report Generation (V9)
# ------------------------------------------------------------------------------
REPORT_FOLDER=reports
